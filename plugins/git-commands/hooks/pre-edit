#!/usr/bin/env bash
# Hook PreToolUse (Edit, Write, MultiEdit, NotebookEdit): na primeira edição de um projeto do
# GitHub em cada sessão, confere se há novidades no GitHub. Se houver, segura a edição e pede
# para o Claude perguntar à pessoa antes. Não age em subagentes (Caminho A) e não segura nada
# quando o GitHub não responde.
# Da segunda edição em diante, sai sem abrir nenhum processo além do cat: no Windows cada
# processo novo custa caro, e o Claude edita muito.
PATH="/usr/bin:/bin:/mingw64/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
case "$0" in */*|*\\*) gc_hook_dir="${0%[/\\]*}" ;; *) gc_hook_dir=. ;; esac
. "$gc_hook_dir/../lib/common.sh"
. "$gc_hook_dir/../lib/proactive.sh"

gc_input=$(cat)
gc_json_field_to gc_agent "$gc_input" agent_id && [ -n "$gc_agent" ] && exit 0
gc_json_field_to gc_path "$gc_input" file_path || gc_json_field_to gc_path "$gc_input" notebook_path || exit 0
gc_bs='\'; gc_path=${gc_path//"$gc_bs"//}
case "$gc_path" in /*|[A-Za-z]:*) ;; *) gc_path="$PWD/$gc_path" ;; esac

# Uma checagem por projeto em cada sessão. O projeto é a pasta mais próxima com .git.
gc_proj=${gc_path%/*}
while [ -n "$gc_proj" ] && [ ! -e "$gc_proj/.git" ]; do
  case "$gc_proj" in */*) gc_proj=${gc_proj%/*} ;; *) gc_proj="" ;; esac
done
[ -n "$gc_proj" ] || exit 0
gc_json_field_to gc_sess "$gc_input" session_id || gc_sess=""
gc_sess=${gc_sess//[![:alnum:]_-]/}
gc_mark_dir="${GIT_COMMANDS_HOME:-$HOME/.git-commands}/sessions/${gc_sess:-sem-sessao}"
gc_mark="$gc_mark_dir/${gc_proj//[![:alnum:]_-]/_}"
[ -e "$gc_mark" ] && exit 0
mkdir -p "$gc_mark_dir" && : > "$gc_mark"

# Primeira edição deste projeto na sessão: agora sim, as checagens com o git.
gc_top=$(gc_toplevel "$gc_path") || exit 0
gc_proactive_applies "$gc_top" || exit 0

gc_quiet_net
gc_fetch_origin "$gc_top" 8 >/dev/null 2>&1 || exit 0
gc_behind=$(git -C "$gc_top" rev-list --count 'HEAD..@{u}' 2>/dev/null) || exit 0
[ "${gc_behind:-0}" -gt 0 ] || exit 0

gc_razao="git-commands: o projeto ${gc_top##*/} tem $gc_behind novidade(s) no GitHub que ainda não estão neste computador. Antes de editar, pare e pergunte à pessoa se ela quer atualizar agora, ver a diferença antes ou deixar para depois (skill git-commands:atualizar). Depois da resposta dela, pode editar normalmente: este aviso não volta nesta sessão."
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$(gc_json_escape "$gc_razao")"
exit 0
