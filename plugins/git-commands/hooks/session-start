#!/usr/bin/env bash
# Hook SessionStart: quando o Claude abre num projeto do GitHub com o modo automático ligado,
# põe no contexto as regras do git-commands. Rápido e sem rede: o Claude espera este hook.
PATH="/usr/bin:/bin:/mingw64/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
case "$0" in */*|*\\*) gc_hook_dir="${0%[/\\]*}" ;; *) gc_hook_dir=. ;; esac
gc_hook_dir=$(cd "$gc_hook_dir" && pwd)
for gc_lib in "$gc_hook_dir"/../lib/*.sh; do . "$gc_lib"; done

gc_input=$(cat)

# Marcadores do hook pre-edit com mais de 2 dias não servem mais.
find "$(gc_home)/sessions" -mindepth 1 -maxdepth 1 -type d -mtime +2 -exec rm -rf {} + 2>/dev/null

gc_cwd=$(gc_json_field "$gc_input" cwd) || gc_cwd=$PWD
gc_cwd=$(gc_norm_path "$gc_cwd")

gc_numero() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; }

# Com a verificação automática ligada: mantém a cópia do agendador em dia, avisa se ela deu erro
# ou parou, e conta as novidades da última verificação (sem rede: o agendador é que fala com o GitHub).
# Os avisos e as novidades só saem ao abrir ou limpar a conversa: na retomada (resume) e no
# resumo (compact), a conversa é a mesma e eles já foram dados.
gc_auto=$(gc_config_get auto_check)
[ "$gc_auto" = on ] && gc_app_sync 2>/dev/null
gc_json_field_to gc_origem "$gc_input" source || gc_origem=""
case "$gc_origem" in compact|resume) gc_auto=off ;; esac
if [ "$gc_auto" = on ]; then
  gc_h=$(gc_home)
  gc_ultima=$(tail -n 1 "$gc_h/check.log" 2>/dev/null)
  case "$gc_ultima" in
    *" erro "[0-9]*)
      # A linha de antes é a mensagem de erro da varredura, quando há uma.
      gc_motivo=$(tail -n 2 "$gc_h/check.log" | sed -n '1s/^git-commands: //p')
      printf 'A verificação automática do git-commands deu erro na última vez que rodou (%s): %s. Na sua primeira resposta, avise a pessoa em uma frase e ofereça resolver (skill git-commands:verificacao-automatica).\n' \
        "${gc_ultima% erro *}" "${gc_motivo:-código ${gc_ultima##* }}" 2>/dev/null
      ;;
    *)
      # Parada: a última verificação tem mais de 3 intervalos. Só avisa se já estava assim numa
      # abertura anterior, 3 intervalos atrás: logo depois de ligar ou acordar o computador,
      # o agendador ainda não teve tempo de rodar.
      gc_int=$(gc_config_get interval); gc_agora=$(date +%s); gc_quando=""; gc_vq=""; gc_vt=""
      [ -f "$gc_h/status.time" ] && read -r gc_quando < "$gc_h/status.time"
      if gc_numero "$gc_quando" && gc_numero "$gc_int" && [ $(( gc_agora - gc_quando )) -gt $(( gc_int * 180 )) ]; then
        [ -f "$gc_h/status.stale" ] && read -r gc_vq gc_vt < "$gc_h/status.stale"
        if [ "$gc_vq" != "$gc_quando" ] || ! gc_numero "$gc_vt"; then
          printf '%s %s\n' "$gc_quando" "$gc_agora" > "$gc_h/status.stale"
        elif [ $(( gc_agora - gc_vt )) -gt $(( gc_int * 180 )) ]; then
          gc_idade=$(( gc_agora - gc_quando ))
          if [ "$gc_idade" -lt 7200 ]; then gc_ha="$(( gc_idade / 60 )) minutos"
          elif [ "$gc_idade" -lt 172800 ]; then gc_ha="$(( gc_idade / 3600 )) horas"
          else gc_ha="$(( gc_idade / 86400 )) dias"; fi
          printf 'A verificação automática do git-commands não roda há %s (o normal é a cada %s minutos). Na sua primeira resposta, avise a pessoa em uma frase e ofereça conferir (skill git-commands:verificacao-automatica).\n' "$gc_ha" "$gc_int" 2>/dev/null
        fi
      fi
      ;;
  esac
  if gc_novas=$(gc_updates_news); then
    gc_lista=$(printf '%s\n' "$gc_novas" | awk -F'\t' '{ printf "%s%s (%s)", (NR > 1 ? ", " : ""), $1, $2 }')
    {
      printf '%s\n' \
        "Novidades no GitHub: $gc_lista." \
        "Na sua primeira resposta, conte isso à pessoa em uma frase e pergunte se ela quer ver agora (skill git-commands:atualizar). Não atualize nada sozinho."
    } 2>/dev/null
  fi
fi

if gc_proactive_applies "$gc_cwd"; then
  gc_top=$(gc_toplevel "$gc_cwd")
  gc_nome=${gc_top##*/}
  gc_aprendidos=$(gc_cmd_learned list | tr '\n' ',' | sed 's/,$//; s/,/, /g')
  [ -n "$gc_aprendidos" ] || gc_aprendidos="nenhum"
  gc_raiz=${CLAUDE_PLUGIN_ROOT:-$GC_ROOT}
  {
    printf '%s\n' \
      "git-commands está ativo neste projeto ($gc_nome), que está ligado ao GitHub." \
      "Ao conversar com a pessoa sobre este projeto, siga as regras do git-commands (detalhes em $gc_raiz/reference/regras.md):" \
      "- Antes de começar uma mudança nova, pergunte se ela quer criar uma branch (skill git-commands:branch-e-pr)." \
      "- Commit: mostre a mensagem sugerida e pergunte se ela quer mudar; só faça o commit depois do ok (skill git-commands:salvar)." \
      "- Tudo que mexe no GitHub (push, criar repositório, abrir ou juntar PR): mostre o que vai fazer e peça ok. Sempre mande o link do PR." \
      "- Quando a mudança terminar, ofereça salvar (commit) e, se estiver numa branch, abrir o PR." \
      "- Na primeira vez que um conceito de git aparecer, explique em 1 ou 2 frases e registre com \`git-commands learned add <id>\`. Conceitos já explicados para esta pessoa: $gc_aprendidos." \
      "- Essas regras valem na conversa com a pessoa; ajudantes e automações (subagentes) seguem sem interrupção."
  } 2>/dev/null
fi
exit 0
